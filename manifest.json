{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.10",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionCapture__",
    "default_icon": {
      "32": "assets/icon.svg"
    }
  },
  "icons": {
    "48": "assets/icon.svg",
    "96": "assets/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "longpage-snap@cyoann.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "default_locale": "en",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
